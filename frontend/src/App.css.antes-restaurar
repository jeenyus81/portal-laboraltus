#root {
  min-height: 100vh;
}

* {
  box-sizing: border-box;
}

body {
  margin: 0;
  font-family: Inter, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI",
    sans-serif;
  background: #f4f3ee;
}

button,
input {
  font: inherit;
}

.app {
  min-height: 100vh;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 32px;
  background: #f4f3ee;
}

.login-card,
.card {
  width: min(100%, 760px);
  background: white;
  border-radius: 18px;
  padding: 40px;
  box-shadow: 0 12px 40px rgba(0, 0, 0, 0.08);
}

.login-card {
  width: min(100%, 440px);
}

.login-header {
  margin-bottom: 32px;
}

.eyebrow {
  margin: 0 0 8px;
  font-size: 13px;
  font-weight: 700;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  color: #000000;
}

h1,
h2 {
  margin-top: 0;
}

.login-header h1 {
  margin-bottom: 10px;
  font-size: 32px;
}

.login-header p:last-child {
  margin-bottom: 0;
  color: #667085;
}

form {
  display: flex;
  flex-direction: column;
  gap: 10px;
}

label {
  margin-top: 8px;
  font-weight: 600;
}

input {
  width: 100%;
  padding: 13px 14px;
  border: 1px solid #d0d5dd;
  border-radius: 10px;
  outline: none;
  background: #ffffff;
}

input:focus {
  border-color: #000000;
  box-shadow: 0 0 0 3px rgba(0, 0, 0, 0.1);
}

button {
  margin-top: 18px;
  padding: 13px 18px;
  border: 0;
  border-radius: 10px;
  background: #000000;
  color: white;
  font-weight: 700;
  cursor: pointer;
}

button:hover {
  background: #222222;
}

button:disabled {
  opacity: 0.6;
  cursor: not-allowed;
}

.secondary {
  margin-top: 0;
  background: #eef0ed;
  color: #344054;
}

.secondary:hover {
  background: #e4e7e3;
}

.error {
  margin: 10px 0 0;
  padding: 10px 12px;
  border-radius: 8px;
  background: #fef3f2;
  color: #b42318;
  font-size: 14px;
}

.header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 24px;
  margin-bottom: 36px;
}

.header h1 {
  margin-bottom: 0;
}

.profile h2 {
  margin-bottom: 20px;
}

.profile-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 16px;
}

.profile-grid > div {
  padding: 16px;
  border: 1px solid #eaecf0;
  border-radius: 12px;
}

.profile-grid span {
  display: block;
  margin-bottom: 6px;
  color: #667085;
  font-size: 13px;
}

.profile-grid strong {
  display: block;
}

.contracts {
  margin-top: 36px;
  padding-top: 32px;
  border-top: 1px solid #eaecf0;
}

.section-header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16px;
  margin-bottom: 20px;
}

.section-header h2 {
  margin-bottom: 0;
}

.contract-count {
  padding: 6px 10px;
  border-radius: 999px;
  background: #f4f3ee;
  color: #000000;
  font-size: 13px;
  font-weight: 700;
}

.muted {
  color: #667085;
}

.empty-state {
  padding: 24px;
  border: 1px dashed #d0d5dd;
  border-radius: 12px;
  text-align: center;
}

.empty-state strong {
  display: block;
  margin-bottom: 6px;
}

.empty-state p {
  margin: 0;
  color: #667085;
}

.contract-list {
  display: flex;
  flex-direction: column;
  gap: 14px;
}

.contract-card {
  padding: 20px;
  border: 1px solid #eaecf0;
  border-radius: 14px;
  background: #fcfcfd;
}

.contract-info {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 16px;
}

.contract-info span {
  display: block;
  margin-bottom: 6px;
  color: #667085;
  font-size: 13px;
}

.contract-info strong {
  display: block;
}

.contract-document {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  margin-top: 18px;
  padding-top: 16px;
  border-top: 1px solid #eaecf0;
}

.download-button {
  margin-top: 0;
}

.no-document {
  color: #667085;
  font-size: 14px;
}

.contract-document label.download-button {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  cursor: pointer;
  border: none;
  font: inherit;
}

.upload-file-label {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  cursor: pointer;
  box-sizing: border-box;
  padding: 0.65rem 1rem;
  border-radius: 8px;
  background: #000000;
  color: white;
  font: inherit;
  font-weight: 600;
  line-height: 1.2;
  text-decoration: none;
  border: 1px solid #000000;
  appearance: none;
  -webkit-appearance: none;
}

.upload-file-label:hover {
  background: #222222;
  border-color: #222222;
}

/* =========================================================
   PANEL RR. HH. — DASHBOARD
   ========================================================= */

.hr-app {
  width: 100%;
  min-height: 100vh;
  display: block;
  margin: 0;
  padding: 0;
  background: #f7f8fa;
}

/* =========================================================
   SIDEBAR
   ========================================================= */

.hr-sidebar {
  position: fixed;
  inset: 0 auto 0 0;
  width: 295px;
  height: 100vh;
  display: flex;
  flex-direction: column;
  padding: 24px 13px 18px;
  box-sizing: border-box;
  background: #18324f;
  color: #ffffff;
  z-index: 100;
}

.hr-brand {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 140px;
  padding: 4px 10px 22px;
}

.hr-logo {
  display: block;
  width: 235px;
  max-width: 100%;
  height: auto;
  object-fit: contain;
}

.hr-nav {
  display: flex;
  flex-direction: column;
  gap: 6px;
}

.hr-nav-button {
  display: flex;
  align-items: center;
  gap: 14px;
  width: 100%;
  margin: 0;
  padding: 13px 14px;
  border: 0;
  border-radius: 9px;
  background: transparent;
  color: #ffffff;
  font-size: 15px;
  font-weight: 600;
  text-align: left;
  box-shadow: none;
}

.hr-nav-button:hover {
  background: rgba(255, 255, 255, 0.08);
  color: #ffffff;
}

.hr-nav-button.active,
.hr-nav-button.active:hover {
  background: #f4f3ee;
  color: #172b45;
}

.hr-nav-icon {
  width: 20px;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 20px;
  font-size: 16px;
}

.hr-sidebar-bottom {
  margin-top: auto;
}

.hr-user-box {
  display: flex;
  align-items: center;
  gap: 12px;
  margin-bottom: 10px;
  padding: 17px 12px;
  border-top: 1px solid rgba(255, 255, 255, 0.12);
}

.hr-user-avatar {
  width: 44px;
  height: 44px;
  border-radius: 50%;
  overflow: hidden;
  background: #f4f3ee;
  flex: 0 0 44px;
}

.hr-user-avatar img {
  width: 100%;
  height: 100%;
  display: block;
  object-fit: contain;
  object-position: center;
  padding: 7px;
  box-sizing: border-box;
}

.hr-user-box strong {
  display: block;
  color: #ffffff;
  font-size: 14px;
}

.hr-user-box span {
  display: block;
  margin-top: 3px;
  color: #d7e0e9;
  font-size: 12px;
}

.hr-logout-button {
  display: flex;
  align-items: center;
  gap: 12px;
  width: 100%;
  margin: 0;
  padding: 13px 14px;
  border-radius: 9px;
  background: #122b45;
  color: #ffffff;
  text-align: left;
  box-shadow: none;
}

.hr-logout-button:hover {
  background: #173957;
}

/* =========================================================
   AREA PRINCIPAL
   ========================================================= */

.hr-main {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  left: 295px;

  width: auto;
  min-width: 0;
  min-height: 0;
  margin: 0;
  padding: 0;

  box-sizing: border-box;

  overflow-y: auto;
  overflow-x: hidden;

  background: #f7f8fa;
}

.hr-shell {
  width: 100%;
  min-width: 0;
  min-height: 100vh;
  margin: 0;
  padding: 0;
  box-sizing: border-box;
}

/* =========================================================
   CABECERA SUPERIOR
   ========================================================= */

.hr-topbar {
  width: 100%;
  min-height: 78px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24px;
  padding: 0 28px;
  box-sizing: border-box;
  background: #ffffff;
  border-bottom: 1px solid #e4e7ec;
}

.hr-topbar-title {
  display: flex;
  flex-direction: column;
  justify-content: center;
  min-width: 0;
}

.hr-topbar-title .eyebrow {
  margin-bottom: 4px;
}

.hr-topbar-title .hr-panel-title {
  margin: 0 !important;
  font-size: 18px !important;
  line-height: 1.2 !important;
  font-weight: 600 !important;
}

.hr-topbar-user {
  display: flex;
  align-items: center;
  gap: 18px;
  flex-shrink: 0;
  margin-left: auto;
}

.hr-topbar-date {
  display: flex;
  align-items: center;
  gap: 9px;
  color: #344054;
  font-size: 14px;
  font-weight: 500;
  white-space: nowrap;
}

.hr-topbar-date-icon {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  font-size: 16px;
}

.hr-topbar-separator {
  width: 1px;
  height: 34px;
  background: #e4e7ec;
}

.hr-topbar-profile {
  display: flex;
  align-items: center;
  gap: 10px;
}

.hr-topbar-avatar {
  width: 42px;
  height: 42px;
  border-radius: 50%;
  overflow: hidden;
  background: #f4f3ee;
  flex: 0 0 42px;
}

.hr-topbar-avatar img {
  width: 100%;
  height: 100%;
  display: block;
  object-fit: cover;
  object-position: center;
}

.hr-topbar-profile strong {
  display: block;
  color: #101828;
  font-size: 14px;
}

.hr-topbar-profile span {
  display: block;
  margin-top: 2px;
  color: #667085;
  font-size: 12px;
}

.hr-topbar-logout {
  width: 38px;
  height: 38px;
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0;
  padding: 0;
  border-radius: 10px;
  background: #f4f3ee !important;
  color: #344054 !important;
  box-shadow: none;
}

.hr-topbar-logout:hover {
  background: #ebe9e2 !important;
}

/* =========================================================
   DASHBOARD
   ========================================================= */

.hr-dashboard {
  width: calc(100% - 48px);
  max-width: none;
  margin: 0 24px;
  padding: 30px 0 38px;
  box-sizing: border-box;
}

.hr-dashboard-welcome {
  margin: 0 0 24px;
}

.hr-dashboard-welcome .eyebrow {
  margin-bottom: 7px;
}

.hr-dashboard-welcome h2 {
  margin: 0 0 8px;
  color: #172b45;
  font-size: 30px;
  line-height: 1.2;
  font-weight: 700;
}

.hr-dashboard-welcome .muted {
  margin: 0;
  color: #667085;
  font-size: 16px;
  line-height: 1.45;
}

/* =========================================================
   CUATRO TARJETAS SUPERIORES
   ========================================================= */

.hr-dashboard-stats {
  width: 100%;
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 22px;
  margin: 0 0 26px;
}

.hr-stat-card {
  position: relative;
  min-width: 0;
  min-height: 146px;
  display: grid;
  grid-template-columns: 74px minmax(0, 1fr);
  align-items: center;
  gap: 17px;
  padding: 22px;
  box-sizing: border-box;
  border: 1px solid #e3e7ec;
  border-radius: 12px;
  background: #ffffff;
  box-shadow: 0 4px 12px rgba(16, 24, 40, 0.04);
}

.hr-stat-icon {
  width: 74px;
  height: 74px;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 18px;
  background: #eaf3fd;
  color: #2f80ed;
  font-size: 21px;
  font-weight: 700;
}

.hr-stat-card:nth-child(2) .hr-stat-icon {
  background: #eaf8f1;
  color: #35b48b;
}

.hr-stat-card:nth-child(3) .hr-stat-icon {
  background: #f2ecff;
  color: #7b61e8;
}

.hr-stat-card:nth-child(4) .hr-stat-icon {
  background: #fff5e2;
  color: #f2a300;
}

.hr-stat-body {
  min-width: 0;
}

.hr-stat-body span {
  display: block;
  margin-bottom: 2px;
  color: #172b45;
  font-size: 15px;
  font-weight: 600;
}

.hr-stat-body strong {
  display: block;
  margin-bottom: 4px;
  color: #2f80ed;
  font-size: 30px;
  line-height: 1;
  font-weight: 700;
}

.hr-stat-card:nth-child(2) .hr-stat-body strong {
  color: #20a77c;
}

.hr-stat-card:nth-child(3) .hr-stat-body strong {
  color: #735be0;
}

.hr-stat-card:nth-child(4) .hr-stat-body strong {
  color: #ef9d00;
}

.hr-stat-body p {
  margin: 0;
  color: #344054;
  font-size: 14px;
  line-height: 1.35;
}

/* Mantener funcionalidad sin cambiar el diseño de la referencia. */
.hr-stat-card > button {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  margin: 0;
  padding: 0;
  border: 0;
  border-radius: 12px;
  background: transparent !important;
  color: transparent !important;
  box-shadow: none !important;
  opacity: 0;
  cursor: pointer;
  z-index: 2;
}

/* =========================================================
   DOS BLOQUES INFERIORES
   ========================================================= */

.hr-dashboard-bottom {
  width: 100%;
  display: grid;
  grid-template-columns: 1.08fr 0.92fr;
  gap: 24px;
  margin: 0 0 24px;
}

.hr-dashboard-box {
  min-width: 0;
  min-height: 338px;
  display: flex;
  flex-direction: column;
  padding: 24px;
  box-sizing: border-box;
  border: 1px solid #e3e7ec;
  border-radius: 12px;
  background: #ffffff;
  box-shadow: 0 4px 12px rgba(16, 24, 40, 0.04);
}

.hr-dashboard-box-header {
  margin: 0 0 18px;
}

.hr-dashboard-box-header .eyebrow {
  margin-bottom: 7px;
}

.hr-dashboard-box-header h2 {
  margin: 0;
  color: #172b45;
  font-size: 20px;
  line-height: 1.25;
}

/* =========================================================
   ACTIVIDAD RECIENTE
   ========================================================= */

.hr-activity-list {
  display: flex;
  flex-direction: column;
  flex: 1;
  min-width: 0;
}

.hr-activity-item {
  display: grid;
  grid-template-columns: 58px minmax(0, 1fr) auto;
  align-items: center;
  gap: 14px;
  padding: 12px 0;
  border-bottom: 1px solid #eaecf0;
}

.hr-activity-item:first-child {
  padding-top: 2px;
}

.hr-activity-item:last-child {
  border-bottom: 0;
}

.hr-activity-icon {
  width: 52px;
  height: 52px;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 14px;
  background: #eaf3fd;
  color: #2f80ed;
  font-size: 18px;
}

.hr-activity-item:nth-child(2) .hr-activity-icon {
  background: #eaf8f1;
  color: #35b48b;
}

.hr-activity-item:nth-child(3) .hr-activity-icon {
  background: #f2ecff;
  color: #7b61e8;
}

.hr-activity-item:nth-child(4) .hr-activity-icon {
  background: #fff5e2;
  color: #f2a300;
}

.hr-activity-content {
  min-width: 0;
}

.hr-activity-content strong {
  display: block;
  margin-bottom: 4px;
  color: #172b45;
  font-size: 14px;
}

.hr-activity-content span {
  display: block;
  color: #475467;
  font-size: 13px;
  line-height: 1.4;
}

.hr-activity-item time {
  color: #667085;
  font-size: 12px;
  white-space: nowrap;
}

.hr-dashboard-view-all {
  align-self: center;
  margin-top: 10px;
  padding: 7px 12px;
  background: transparent !important;
  color: #2f80ed !important;
  font-size: 13px;
  font-weight: 600;
  box-shadow: none !important;
}

/* =========================================================
   ACCESOS RAPIDOS
   ========================================================= */

.hr-quick-actions {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 16px;
  flex: 1;
  min-width: 0;
}

.hr-quick-action {
  min-width: 0;
  min-height: 100px;
  display: flex;
  align-items: center;
  gap: 14px;
  margin: 0;
  padding: 16px;
  box-sizing: border-box;
  border: 1px solid #dbe4ee;
  border-radius: 12px;
  background: #eef6ff !important;
  color: #172b45 !important;
  text-align: left;
  box-shadow: none;
}

.hr-quick-action:nth-child(2) {
  background: #edf9f4 !important;
}

.hr-quick-action:nth-child(3) {
  background: #f4efff !important;
}

.hr-quick-action:nth-child(4) {
  background: #fff7e8 !important;
}

.hr-quick-action:hover {
  filter: brightness(0.985);
}

.hr-quick-action-icon {
  width: 48px;
  height: 48px;
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 48px;
  border-radius: 13px;
  background: #ffffff !important;
  color: #2f80ed !important;
  font-size: 18px;
}

.hr-quick-action:nth-child(2) .hr-quick-action-icon {
  color: #35b48b !important;
}

.hr-quick-action:nth-child(3) .hr-quick-action-icon {
  color: #7b61e8 !important;
}

.hr-quick-action:nth-child(4) .hr-quick-action-icon {
  color: #f2a300 !important;
}

.hr-quick-action-content {
  min-width: 0;
  flex: 1 1 auto;
}

.hr-quick-action-content strong {
  display: block;
  margin: 0 0 5px;
  color: #172b45 !important;
  font-size: 14px;
  line-height: 1.35;
  white-space: normal;
  overflow-wrap: break-word;
  word-break: normal;
}

.hr-quick-action-content span {
  display: block;
  margin: 0;
  color: #667085 !important;
  font-size: 12px;
  line-height: 1.35;
  white-space: normal;
  overflow-wrap: break-word;
  word-break: normal;
}

.hr-quick-action-arrow {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 20px;
  width: 20px;
  color: #2f80ed !important;
  font-size: 20px !important;
  line-height: 1;
  white-space: nowrap;
}

/* =========================================================
   INFORMACION
   ========================================================= */

.hr-dashboard-information {
  width: 100%;
  min-height: 104px;
  display: flex;
  align-items: center;
  gap: 16px;
  padding: 20px 24px;
  box-sizing: border-box;
  border: 1px solid #e3e7ec;
  border-radius: 12px;
  background: #ffffff;
  box-shadow: 0 4px 12px rgba(16, 24, 40, 0.04);
}

.hr-information-icon {
  width: 44px;
  height: 44px;
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 44px;
  border-radius: 50%;
  background: #eaf3fd;
  color: #2f80ed;
  font-size: 18px;
}

.hr-information-content {
  min-width: 0;
}

.hr-information-content strong {
  display: block;
  margin-bottom: 5px;
  color: #172b45;
  font-size: 15px;
}

.hr-information-content p {
  margin: 0;
  color: #475467;
  font-size: 14px;
  line-height: 1.45;
}

/* =========================================================
   TITULO DEL PANEL
   ========================================================= */

.hr-panel-title {
  font-size: 18px !important;
  line-height: 1.2 !important;
  font-weight: 600 !important;
  margin: 0 !important;
}

/* =========================================================
   RESPONSIVE
   ========================================================= */

@media (max-width: 1180px) {
  .hr-dashboard {
    padding-left: 22px;
    padding-right: 22px;
  }

  .hr-dashboard-stats {
    gap: 16px;
  }

  .hr-stat-card {
    grid-template-columns: 60px minmax(0, 1fr);
    padding: 18px;
  }

  .hr-stat-icon {
    width: 60px;
    height: 60px;
  }
}

@media (max-width: 980px) {
  .hr-sidebar {
    width: 230px;
  }

  .hr-main {
    width: calc(100% - 230px);
    margin-left: 230px;
  }

  .hr-dashboard-stats {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .hr-dashboard-bottom {
    grid-template-columns: 1fr;
  }
}

@media (max-width: 760px) {
  .hr-topbar {
    min-height: 72px;
    padding: 0 18px;
  }

